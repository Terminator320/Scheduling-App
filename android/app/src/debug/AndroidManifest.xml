<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug-only: allow cleartext HTTP to the Firebase emulator suite
         (127.0.0.1 via adb reverse, 10.0.2.2 for Android emulator, localhost).
         This file is in src/debug so it is NOT merged into release builds. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig">
        <!-- Firebase Performance: mirror trace/metric logs to Logcat. Debug-only
             so release builds don't carry the extra logging. -->
        <meta-data
            android:name="firebase_performance_logcat_enabled"
            android:value="true" />
    </application>
</manifest>
