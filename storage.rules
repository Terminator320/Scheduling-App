rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // True when the caller is an active admin, via the syncUsersByUid bridge doc.
    function isAdmin() {
      let bridge = firestore.get(
        /databases/(default)/documents/usersByUid/$(request.auth.uid)
      );
      return isSignedIn()
        && bridge != null
        && bridge.data.role == 'admin'
        && bridge.data.status == 'active';
    }

    // Returns true when the current user's Firestore doc ID appears in the
    // appointment's employeeIds array.
    function isAssignedToAppointment(appointmentId) {
      let bridge = firestore.get(
        /databases/(default)/documents/usersByUid/$(request.auth.uid)
      );
      let appt = firestore.get(
        /databases/(default)/documents/appointments/$(appointmentId)
      );
      // `status == 'active'` is load-bearing — the bridge doc survives deactivation,
      // so without it a disabled employee keeps reading job photos.
      return isSignedIn()
        && bridge != null
        && appt != null
        && bridge.data.status == 'active'
        && bridge.data.docId in appt.data.employeeIds;
    }

    // ── Appointment images ────────────────────────────────────────────────────
    match /appointments/{appointmentId}/images/{fileName} {

      // Read: admin sees all; assigned employees see their appointments' images.
      allow read: if isAdmin() || isAssignedToAppointment(appointmentId);

      // Admin only — employees are view-only on appointments and the upload flow only
      // runs in admin sessions. contentType is client-set and forgeable; the real
      // defense is the magic-byte trigger in functions/index.js, these checks are just
      // defense in depth.
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)');

      // Admin only — employees can't modify the pictures array, so letting them delete
      // the blob would strand the doc with broken imageUrls.
      allow delete: if isAdmin();
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
