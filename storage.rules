rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Reads the bridge doc maintained by the syncUsersByUid Cloud Function
    // (see functions/index.js). Returns true when the caller is an active admin.
    function isAdmin() {
      let bridge = firestore.get(
        /databases/(default)/documents/usersByUid/$(request.auth.uid)
      );
      return isSignedIn()
        && bridge != null
        && bridge.data.role == 'admin'
        && bridge.data.status == 'active';
    }

    // Returns true when the current user's Firestore doc ID appears in the
    // appointment's employeeIds array.
    function isAssignedToAppointment(appointmentId) {
      let bridge = firestore.get(
        /databases/(default)/documents/usersByUid/$(request.auth.uid)
      );
      let appt = firestore.get(
        /databases/(default)/documents/appointments/$(appointmentId)
      );
      return isSignedIn()
        && bridge != null
        && appt != null
        && bridge.data.docId in appt.data.employeeIds;
    }

    // ── Appointment images ────────────────────────────────────────────────────
    match /appointments/{appointmentId}/images/{fileName} {

      // Read: admin sees all; assigned employees see their appointments' images.
      allow read: if isAdmin() || isAssignedToAppointment(appointmentId);

      // Write: admin only. Employees are view-only on appointments — the
      // firestore.rules employee-update path is capped to ['status',
      // 'updatedAt'] with status=='done' — and the upload flow runs only in
      // admin sessions (AppointmentImageUploadService -> updateAppointmentPictures).
      // Content-type is set by the client and forgeable — the real defense is
      // the magic-byte trigger in functions/index.js (validateUploadedImage);
      // contentType + size checks here are defense in depth.
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png)');

      // Delete: admin only. Employees cannot modify the Firestore `pictures`
      // array, so allowing them to delete the underlying blob would strand
      // the appointment doc with broken imageUrls.
      allow delete: if isAdmin();
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
