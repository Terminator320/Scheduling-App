rules_version = '2';

// Role resolution depends on the `usersByUid/{uid}` bridge collection, which is
// maintained by the `syncUsersByUid` Cloud Function in `functions/index.js`.
// Rules can only `get` documents by full path, and `users` docs use Firestore-
// generated IDs — the bridge translates auth uid → users-doc-id + role + status.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ─────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function userByUid() {
      return get(/databases/$(database)/documents/usersByUid/$(request.auth.uid));
    }

    function userByUidExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usersByUid/$(request.auth.uid));
    }

    function isAdmin() {
      return userByUidExists()
        && userByUid().data.role == 'admin'
        && userByUid().data.status == 'active';
    }

    // Returns the Firestore doc ID for the current user (via the bridge doc).
    // Used to check whether a UID is in appointment.employeeIds.
    function myDocId() {
      return userByUid().data.docId;
    }

    function isAssignedEmployee(appointmentData) {
      return userByUidExists()
        && myDocId() in appointmentData.employeeIds;
    }

    // Firestore's default is deny-everything-not-explicitly-allowed, so no
    // catch-all deny-rule is needed. Adding one at this level OR's with the
    // specific matches and has been observed to interact oddly with list
    // queries; relying on the default is simpler and equally restrictive.

    // ── usersByUid (bridge collection) ───────────────────────────────────────
    // Written only by the syncUsersByUid Cloud Function via Admin SDK. Clients
    // can read their own doc; no client writes allowed.
    match /usersByUid/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ── rateLimits (abuse counters) ──────────────────────────────────────────
    // Written only by the enforceDurableRateLimit helper in the Cloud Functions
    // via Admin SDK. No client may read or write: a client that could reset or
    // read its own counter would defeat the auth-route brute-force cap. The
    // default-deny would already block this; the explicit rule documents intent
    // for a security-sensitive collection.
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // signupCodes hold the sha256 hash of one-time invite codes. Only Cloud
    // Functions (Admin SDK) touch them — a client able to read a hash could
    // brute-force the code offline; one able to write could mint codes.
    match /signupCodes/{codeHash} {
      allow read, write: if false;
    }

    // ── users ─────────────────────────────────────────────────────────────────
    // Read: admins see all; active employees see active peers (picker/display);
    // a registering user can find their own invited doc by email match.
    // Write: admin only. Invite activation is server-side (the redeemSignupCode
    // callable via the Admin SDK), so there is no client self-activation path.
    match /users/{userId} {
      // The invited-doc lookup is intentionally NOT exposed as a client-side
      // list query — Firestore's rules engine cannot prove
      // `resource.data.email == request.auth.token.email` from a query's
      // `where('email', '==', X)` constraint, so any client query would be
      // rejected with permission-denied. Invite resolution and activation run
      // server-side via the signup-code callables (Admin SDK), so this clause
      // can stay tight without breaking the app.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.status == 'active')
        || (isSignedIn() && resource.data.uid == request.auth.uid)
        || (isSignedIn()
            && resource.data.status == 'invited'
            && resource.data.email == request.auth.token.email);

      allow create, delete: if isAdmin();

      // `colorValue` is stored as a stringified int in the user doc. Reject
      // writes that don't parse as an integer so a malformed write can't
      // make the client fall back to the default blue.
      function isValidColorValue(s) {
        return s is string && s.matches('^-?[0-9]+$');
      }

      // Constrain the privilege/state fields an admin write can land on, so a
      // compromised admin session can't mint a bogus role (e.g. 'superuser')
      // or an out-of-allowlist status that would desync the usersByUid bridge.
      function isValidRole(r) {
        return r in ['admin', 'employee'];
      }
      function isValidUserStatus(s) {
        return s in ['active', 'disabled', 'invited'];
      }

      // Only an admin can update a user doc. Invite activation (writing the
      // auth uid + flipping status to 'active') is done server-side by the
      // redeemSignupCode callable via the Admin SDK — there is no client
      // self-activation path, so an unverified registrant can't claim a doc.
      allow update: if isAdmin()
            && (!('colorValue' in request.resource.data.keys())
                || isValidColorValue(request.resource.data.colorValue))
            && (!('role' in request.resource.data.keys())
                || isValidRole(request.resource.data.role))
            && (!('status' in request.resource.data.keys())
                || isValidUserStatus(request.resource.data.status));
    }

    // ── appointments ──────────────────────────────────────────────────────────
    // Allowed status values (admin writes are validated; employee writes are
    // additionally restricted to 'done' only, see below).
    function isValidAppointmentStatus(s) {
      return s in ['pending', 'confirmed', 'in_progress', 'done', 'cancelled'];
    }

    match /appointments/{appointmentId} {
      // Read: admin sees all; assigned employee sees their appointments.
      allow read: if isAdmin() || isAssignedEmployee(resource.data);

      // Create: admin only (employees don't create appointments). Reject
      // unknown status values from the client.
      allow create: if isAdmin()
        && isValidAppointmentStatus(request.resource.data.status);

      // Update: admin full access (status allowlist enforced); employees can
      // ONLY mark an assigned appointment as 'done'. They cannot cancel,
      // edit metadata, or replace pictures — the UI gates these to admins,
      // these rules are the defence-in-depth.
      allow update: if (isAdmin()
            && isValidAppointmentStatus(request.resource.data.status))
        || (isAssignedEmployee(resource.data)
            && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['status', 'updatedAt'])
            && request.resource.data.status == 'done');

      // Delete: admin only.
      allow delete: if isAdmin();
    }

    // ── clients ───────────────────────────────────────────────────────────────
    // Client PII — admin-only. Employees never need direct access.
    function isValidClientData(data) {
      return (!('name' in data) || (data.name is string && data.name.size() <= 200))
        && (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 200))
        && (!('firstName' in data) || (data.firstName is string && data.firstName.size() <= 200))
        && (!('lastName' in data) || (data.lastName is string && data.lastName.size() <= 200))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && (!('mobile' in data) || (data.mobile is string && data.mobile.size() <= 32))
        && (!('email' in data) || (data.email is string && data.email.size() <= 320))
        && (!('noFixedAddress' in data) || data.noFixedAddress is bool);
    }

    match /clients/{clientId} {
      allow read: if isAdmin();
      // `waveCustomerId` and `wave` are written exclusively by Cloud Functions
      // via Admin SDK (which bypasses these rules). The client app must never
      // set or modify these fields; reject any create that includes them.
      allow create: if isAdmin()
        && isValidClientData(request.resource.data)
        && !('waveCustomerId' in request.resource.data.keys())
        && !('wave' in request.resource.data.keys());
      // For updates, reject only if the client is changing/adding the Wave
      // fields — an update that leaves them untouched has no affected keys.
      allow update: if isAdmin()
        && isValidClientData(request.resource.data)
        && !request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasAny(['waveCustomerId', 'wave']);
      allow delete: if isAdmin();
    }

    // ── wave (Wave Accounting connection metadata) ────────────────────────────
    // Written exclusively by Cloud Functions via Admin SDK (connection status,
    // businessId, last-sync timestamps; the access token lives only in Secret
    // Manager, never here). No client may read connection state — treat this
    // collection like rateLimits. The default
    // deny-everything would already block access; the explicit rule documents
    // intent for a security-sensitive collection.
    match /wave/{docId} {
      allow read, write: if false;
    }

    // ── waveSyncQueue (outbox for Wave API sync jobs) ─────────────────────────
    // Jobs are enqueued and processed exclusively by Cloud Functions via Admin
    // SDK. No client may read pending jobs, inspect retry state, or reset the
    // queue — doing so could expose Wave API credentials embedded in job
    // payloads or allow a client to cancel/replay sync operations.
    match /waveSyncQueue/{jobId} {
      allow read, write: if false;
    }
  }
}
