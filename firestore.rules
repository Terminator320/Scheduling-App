rules_version = '2';

// Role resolution goes through the `usersByUid/{uid}` bridge, kept up to date by
// syncUsersByUid in functions/index.js. Rules can only `get` a doc by its full path,
// and `users` docs have Firestore-generated IDs, so this bridge is how we look up a
// user from just their auth uid.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ─────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function userByUid() {
      return get(/databases/$(database)/documents/usersByUid/$(request.auth.uid));
    }

    function userByUidExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usersByUid/$(request.auth.uid));
    }

    function isAdmin() {
      return userByUidExists()
        && userByUid().data.role == 'admin'
        && userByUid().data.status == 'active';
    }

    // True when the person making the request — not the resource being read — is an
    // active user. Checking the caller instead of the resource is what keeps list
    // queries provable.
    function isActiveUser() {
      return userByUidExists()
        && userByUid().data.status == 'active';
    }

    // Returns the current user's Firestore doc ID — we use this to check whether
    // they're in an appointment's employeeIds.
    function myDocId() {
      return userByUid().data.docId;
    }

    // We also check active status here, because deactivating someone doesn't revoke
    // their Auth credential — without this, a disabled employee could keep reading
    // their assigned jobs.
    function isAssignedEmployee(appointmentData) {
      return isActiveUser()
        && myDocId() in appointmentData.employeeIds;
    }

    // We don't add a catch-all deny rule here — Firestore already denies by default,
    // and we've seen an explicit one interact oddly with list queries.

    // ── usersByUid (bridge collection) ───────────────────────────────────────
    // Only the syncUsersByUid Cloud Function writes here, via the Admin SDK. Clients
    // can read their own doc, but none of them can write.
    match /usersByUid/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ── rateLimits (abuse counters) ──────────────────────────────────────────
    // Admin SDK only, via enforceDurableRateLimit — if a client could read or reset
    // its own counter, it would defeat the brute-force cap on auth routes.
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // Admin SDK only — a client that could read a code hash could brute-force it
    // offline, and one that could write could just mint its own codes.
    match /signupCodes/{codeHash} {
      allow read, write: if false;
    }

    // Admin-SDK-only idempotency ledger for the 30-minute reminder sweep. If a client
    // could delete an entry, it could force a duplicate reminder.
    match /appointmentReminders/{id} {
      allow read, write: if false;
    }

    // Admin-SDK-only idempotency ledger for the overdue "job finished?" sweep — same
    // posture as appointmentReminders above.
    match /appointmentOverduePrompts/{id} {
      allow read, write: if false;
    }

    // Admin-SDK-only claim ledger that collapses a repeat-series batch into one push
    // per employee per kind — same posture as the ledgers above.
    match /appointmentSeriesNotices/{id} {
      allow read, write: if false;
    }

    // Admin-SDK-only mapping of each tech to their live-activity appointment, owned
    // entirely by the server — a client write here could redirect another tech's card
    // and leak a client's address.
    match /liveActivityCards/{employeeDocId} {
      allow read, write: if false;
    }

    // ── users ─────────────────────────────────────────────────────────────────
    // Admins can read everything; active employees can see active peers (for pickers
    // and display); and someone signing up can find their own invited doc by email
    // match. Only an admin can write — invite activation happens server-side via
    // redeemSignupCode, so there's no way for a client to self-activate.
    match /users/{userId} {
      // The invited-doc clause only works for a direct get, not a client list query,
      // since Firestore can't prove the email-equality check from a query constraint.
      // The active-peers clause checks the caller (via the usersByUid bridge) rather
      // than the resource, which keeps list queries provable and stops a signed-in
      // stranger with no bridge doc from dumping the whole staff directory.
      allow read: if isAdmin()
        || (isActiveUser() && resource.data.status == 'active')
        || (isSignedIn() && resource.data.uid == request.auth.uid)
        || (isSignedIn()
            && request.auth.token.email_verified == true
            && resource.data.status == 'invited'
            && resource.data.email == request.auth.token.email);

      allow create, delete: if isAdmin();

      // Rejects a colorValue write that isn't a valid integer string — otherwise a bad
      // value could sneak through and the client would silently fall back to the
      // default blue.
      function isValidColorValue(s) {
        return s is string && s.matches('^-?[0-9]+$');
      }

      // Keeps role and status limited to the allowlist, so a compromised admin
      // session can't mint a bogus role or throw the usersByUid bridge out of sync.
      function isValidRole(r) {
        return r in ['admin', 'employee'];
      }
      function isValidUserStatus(s) {
        return s in ['active', 'disabled', 'invited'];
      }

      // Only an admin can update. Invite activation happens server-side via
      // redeemSignupCode, so there's no client self-activation path. `uid` links this
      // doc to an Auth account and clients can never change it — rewriting it could
      // hijack another account's bridge doc.
      allow update: if isAdmin()
            && !request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasAny(['uid'])
            && (!('colorValue' in request.resource.data.keys())
                || isValidColorValue(request.resource.data.colorValue))
            && (!('role' in request.resource.data.keys())
                || isValidRole(request.resource.data.role))
            && (!('status' in request.resource.data.keys())
                || isValidUserStatus(request.resource.data.status));

      // FCM device tokens — a user can only read or write their own, and writes are
      // shape-constrained so nobody can plant a token under a spoofed identity.
      match /fcmTokens/{token} {
        allow read, delete: if isActiveUser() && myDocId() == userId;
        allow create, update: if isActiveUser()
          && myDocId() == userId
          && request.resource.data.keys().hasOnly(
              ['platform', 'locale', 'uid', 'createdAt', 'updatedAt'])
          && request.resource.data.locale in ['en', 'fr']
          && request.resource.data.platform in ['ios', 'android']
          && request.resource.data.uid == request.auth.uid
          && (!('createdAt' in request.resource.data.keys())
              || request.resource.data.createdAt is timestamp)
          && (!('updatedAt' in request.resource.data.keys())
              || request.resource.data.updatedAt is timestamp);
      }

      // Live Activity tokens — same self-only rule as fcmTokens, iOS-only, keyed by
      // the ActivityKit activity id or the literal `pushToStart`.
      match /liveActivityTokens/{activityId} {
        allow read, delete: if isActiveUser() && myDocId() == userId;
        allow create, update: if isActiveUser()
          && myDocId() == userId
          // No `appointmentId` here — that association lives server-side in
          // liveActivityCards, since the device can't read back ActivityKit attributes.
          && request.resource.data.keys().hasOnly(
              ['token', 'kind', 'employeeDocId', 'platform',
               'locale', 'uid', 'createdAt', 'updatedAt', 'expiresAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 500
          && request.resource.data.kind in ['pushToStart', 'update']
          && request.resource.data.locale in ['en', 'fr']
          && request.resource.data.platform in ['ios']
          && request.resource.data.uid == request.auth.uid
          && (!('employeeDocId' in request.resource.data.keys())
              || request.resource.data.employeeDocId == userId)
          && (!('createdAt' in request.resource.data.keys())
              || request.resource.data.createdAt is timestamp)
          && (!('updatedAt' in request.resource.data.keys())
              || request.resource.data.updatedAt is timestamp)
          // This has to be required: the TTL policy and pruneExpiredActivityTokens both
          // key on it, and Firestore skips docs that are missing the field — so an
          // optional value would let a client mint rows nothing could ever clean up.
          // We cap it just above liveActivityPushToStartTtl (30d) so a client can't write
          // an expiry that outlives the sweep — raise both together if that changes.
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt
             < request.time + duration.value(31, 'd');
      }

      // Live-location presence for travel-time reminders. Owners can only touch their
      // own doc here — admins read everything via the collectionGroup rule below.
      // `updatedAt == request.time` forces serverTimestamp(), so a client can't fake
      // freshness by writing a future timestamp.
      match /presence/{presenceId} {
        allow read, delete: if isActiveUser() && myDocId() == userId;
        allow create, update: if isActiveUser()
          && myDocId() == userId
          && presenceId == 'location'
          && request.resource.data.keys().hasOnly(
              ['lat', 'lng', 'updatedAt', 'uid'])
          && request.resource.data.lat is number
          && request.resource.data.lat >= -90
          && request.resource.data.lat <= 90
          && request.resource.data.lng is number
          && request.resource.data.lng >= -180
          && request.resource.data.lng <= 180
          && request.resource.data.updatedAt == request.time
          && request.resource.data.uid == request.auth.uid;
      }
    }

    // ── presence (admin live-map read) ───────────────────────────────────
    // Gives admins read access (get + list, including collectionGroup) over every
    // presence subcollection — the nested rule above still governs what an owner can
    // do. isAdmin() only checks the caller, which is what keeps this unfiltered
    // collection-group query provable. Note that {path=**} reserves the `presence`
    // subcollection name for any future collection too.
    match /{path=**}/presence/{presenceId} {
      allow read: if isAdmin();
    }

    // ── appointments ──────────────────────────────────────────────────────────
    // The lifecycle goes pending -> in_progress -> done, plus cancelled. Employees
    // can only ever write 'done' (see below).
    function isValidAppointmentStatus(s) {
      return s in ['pending', 'in_progress', 'done', 'cancelled'];
    }

    match /appointments/{appointmentId} {
      // Read: admin sees all; assigned employee sees their appointments.
      allow read: if isAdmin() || isAssignedEmployee(resource.data);

      // Admin only, and rejects any status value the client sends that isn't on
      // the allowlist.
      allow create: if isAdmin()
        && isValidAppointmentStatus(request.resource.data.status);

      // Admins have full access (with the status allowlist still enforced); an
      // assigned employee can only flip the status to 'done' — nothing else.
      allow update: if (isAdmin()
            && isValidAppointmentStatus(request.resource.data.status))
        || (isAssignedEmployee(resource.data)
            && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['status', 'updatedAt'])
            && request.resource.data.status == 'done');

      // Delete: admin only.
      allow delete: if isAdmin();
    }

    // ── clients ───────────────────────────────────────────────────────────────
    // This is all client PII, so it's admin-only — employees never need direct
    // access to it.
    function isValidClientData(data) {
      return (!('name' in data) || (data.name is string && data.name.size() <= 200))
        && (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 200))
        && (!('firstName' in data) || (data.firstName is string && data.firstName.size() <= 200))
        && (!('lastName' in data) || (data.lastName is string && data.lastName.size() <= 200))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && (!('mobile' in data) || (data.mobile is string && data.mobile.size() <= 32))
        && (!('email' in data) || (data.email is string && data.email.size() <= 320))
        && (!('address' in data) || (data.address is string && data.address.size() <= 500))
        && (!('apt' in data) || (data.apt is string && data.apt.size() <= 64))
        && (!('city' in data) || (data.city is string && data.city.size() <= 128))
        && (!('province' in data) || (data.province is string && data.province.size() <= 128))
        && (!('country' in data) || (data.country is string && data.country.size() <= 128))
        && (!('postalCode' in data) || (data.postalCode is string && data.postalCode.size() <= 32))
        // Known gap: rules can't cap the length of each contact's fields, only how
        // many contacts there are. So an admin write can still reach Firestore's 1 MB
        // ceiling and fan out via propagateClientEdits — we've accepted that since
        // it's admin-only. The real fix is a per-field TextLimits cap in the contacts
        // editor, not tightening this array-length number.
        && (!('contacts' in data) || (data.contacts is list && data.contacts.size() <= 50))
        && (!('noFixedAddress' in data) || data.noFixedAddress is bool);
    }

    match /clients/{clientId} {
      allow read: if isAdmin();
      // `waveCustomerId` and `wave` are written only by Cloud Functions via the
      // Admin SDK, which bypasses these rules entirely. The client app should never
      // touch these fields, so we reject any create that includes them.
      allow create: if isAdmin()
        && isValidClientData(request.resource.data)
        && !('waveCustomerId' in request.resource.data.keys())
        && !('wave' in request.resource.data.keys());
      // On updates we only reject if the client is trying to change or add the Wave
      // fields — an update that leaves them alone has no affected keys, so it's fine.
      allow update: if isAdmin()
        && isValidClientData(request.resource.data)
        && !request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasAny(['waveCustomerId', 'wave']);
      allow delete: if isAdmin();
    }

    // ── wave (Wave Accounting connection metadata) ────────────────────────────
    // Only Cloud Functions write here, via the Admin SDK — connection status,
    // businessId, last-sync timestamps. The access token itself lives only in Secret
    // Manager, never here. No client can read connection state; treat this like
    // rateLimits.
    match /wave/{docId} {
      allow read, write: if false;
    }

    // ── waveSyncQueue (outbox for Wave API sync jobs) ─────────────────────────
    // Cloud Functions enqueue and process these jobs via the Admin SDK. No client
    // can read pending jobs, inspect retry state, or reset the queue — that could
    // expose Wave API credentials sitting in job payloads, or let a client cancel
    // or replay a sync.
    match /waveSyncQueue/{jobId} {
      allow read, write: if false;
    }
  }
}
