rules_version = '2';

// Role resolution goes through the `usersByUid/{uid}` bridge (maintained by
// syncUsersByUid in functions/index.js), since rules can only `get` by full
// path and `users` docs use Firestore-generated IDs.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ─────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function userByUid() {
      return get(/databases/$(database)/documents/usersByUid/$(request.auth.uid));
    }

    function userByUidExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/usersByUid/$(request.auth.uid));
    }

    function isAdmin() {
      return userByUidExists()
        && userByUid().data.role == 'admin'
        && userByUid().data.status == 'active';
    }

    // True when the CALLER (not the resource) is an active user, keeping list queries provable.
    function isActiveUser() {
      return userByUidExists()
        && userByUid().data.status == 'active';
    }

    // Returns the current user's Firestore doc ID, used to check appointment.employeeIds membership.
    function myDocId() {
      return userByUid().data.docId;
    }

    // Requires an active-status gate too: deactivation doesn't revoke the Auth credential,
    // so without it a disabled employee would keep reading their assigned jobs.
    function isAssignedEmployee(appointmentData) {
      return isActiveUser()
        && myDocId() in appointmentData.employeeIds;
    }

    // No catch-all deny rule needed — Firestore already denies by default, and an explicit
    // one here has been observed to interact oddly with list queries.

    // ── usersByUid (bridge collection) ───────────────────────────────────────
    // Written only by the syncUsersByUid Cloud Function via Admin SDK. Clients
    // can read their own doc; no client writes allowed.
    match /usersByUid/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ── rateLimits (abuse counters) ──────────────────────────────────────────
    // Admin-SDK-only (enforceDurableRateLimit); a client that could read/reset its own
    // counter would defeat the auth-route brute-force cap.
    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // Admin-SDK-only — a client able to read a code hash could brute-force it offline,
    // and one able to write could mint codes.
    match /signupCodes/{codeHash} {
      allow read, write: if false;
    }

    // Admin-SDK-only idempotency ledger for the 30-minute reminder sweep; a client that
    // could delete an entry could force duplicate reminders.
    match /appointmentReminders/{id} {
      allow read, write: if false;
    }

    // Admin-SDK-only idempotency ledger for the overdue "job finished?" sweep; same
    // posture as appointmentReminders.
    match /appointmentOverduePrompts/{id} {
      allow read, write: if false;
    }

    // Admin-SDK-only claim ledger that collapses a repeat-series batch into one push
    // per employee per kind; same posture as the ledgers above.
    match /appointmentSeriesNotices/{id} {
      allow read, write: if false;
    }

    // Admin-SDK-only server-owned mapping of tech to live-activity appointment; a client
    // write could redirect another tech's card and leak a client's address.
    match /liveActivityCards/{employeeDocId} {
      allow read, write: if false;
    }

    // ── users ─────────────────────────────────────────────────────────────────
    // Read: admins see all; active employees see active peers (picker/display);
    // a registering user can find their own invited doc by email match.
    // Write: admin only. Invite activation is server-side (the redeemSignupCode
    // callable via the Admin SDK), so there is no client self-activation path.
    match /users/{userId} {
      // The invited-doc clause only matches a direct get, not a client list query —
      // Firestore can't prove the email-equality condition from a query constraint.
      // The active-peers clause is caller-side (via the usersByUid bridge) so the list
      // query stays provable, and blocks a signed-in stranger with no bridge doc from
      // dumping the staff directory.
      allow read: if isAdmin()
        || (isActiveUser() && resource.data.status == 'active')
        || (isSignedIn() && resource.data.uid == request.auth.uid)
        || (isSignedIn()
            && request.auth.token.email_verified == true
            && resource.data.status == 'invited'
            && resource.data.email == request.auth.token.email);

      allow create, delete: if isAdmin();

      // Rejects a colorValue write that doesn't parse as an integer, so a malformed
      // value can't fall back to the default blue.
      function isValidColorValue(s) {
        return s is string && s.matches('^-?[0-9]+$');
      }

      // Constrains role/status to the allowlist so a compromised admin session can't
      // mint a bogus role or desync the usersByUid bridge.
      function isValidRole(r) {
        return r in ['admin', 'employee'];
      }
      function isValidUserStatus(s) {
        return s in ['active', 'disabled', 'invited'];
      }

      // Admin-only; invite activation happens server-side via redeemSignupCode, so
      // there's no client self-activation path. `uid` links the doc to an Auth account
      // and is client-immutable — rewriting it could hijack another account's bridge doc.
      allow update: if isAdmin()
            && !request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasAny(['uid'])
            && (!('colorValue' in request.resource.data.keys())
                || isValidColorValue(request.resource.data.colorValue))
            && (!('role' in request.resource.data.keys())
                || isValidRole(request.resource.data.role))
            && (!('status' in request.resource.data.keys())
                || isValidUserStatus(request.resource.data.status));

      // FCM device tokens; a user can only read/write their own, and writes are
      // shape-constrained so a token can't be planted under a spoofed identity.
      match /fcmTokens/{token} {
        allow read, delete: if isActiveUser() && myDocId() == userId;
        allow create, update: if isActiveUser()
          && myDocId() == userId
          && request.resource.data.keys().hasOnly(
              ['platform', 'locale', 'uid', 'createdAt', 'updatedAt'])
          && request.resource.data.locale in ['en', 'fr']
          && request.resource.data.platform in ['ios', 'android']
          && request.resource.data.uid == request.auth.uid
          && (!('createdAt' in request.resource.data.keys())
              || request.resource.data.createdAt is timestamp)
          && (!('updatedAt' in request.resource.data.keys())
              || request.resource.data.updatedAt is timestamp);
      }

      // Live Activity tokens; same self-only discipline as fcmTokens, iOS-only, keyed
      // by the ActivityKit activity id or the literal `pushToStart`.
      match /liveActivityTokens/{activityId} {
        allow read, delete: if isActiveUser() && myDocId() == userId;
        allow create, update: if isActiveUser()
          && myDocId() == userId
          // No `appointmentId` here — that association lives server-side in
          // liveActivityCards, since the device can't read back ActivityKit attributes.
          && request.resource.data.keys().hasOnly(
              ['token', 'kind', 'employeeDocId', 'platform',
               'locale', 'uid', 'createdAt', 'updatedAt', 'expiresAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 500
          && request.resource.data.kind in ['pushToStart', 'update']
          && request.resource.data.locale in ['en', 'fr']
          && request.resource.data.platform in ['ios']
          && request.resource.data.uid == request.auth.uid
          && (!('employeeDocId' in request.resource.data.keys())
              || request.resource.data.employeeDocId == userId)
          && (!('createdAt' in request.resource.data.keys())
              || request.resource.data.createdAt is timestamp)
          && (!('updatedAt' in request.resource.data.keys())
              || request.resource.data.updatedAt is timestamp)
          // Required because the TTL policy and pruneExpiredActivityTokens both key on
          // this field, and Firestore excludes docs missing it — an optional value would
          // let a client mint permanently undeletable rows. Bounded just above
          // liveActivityPushToStartTtl (30d) so a client can't outlive the sweep's reach —
          // raise both together.
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt
             < request.time + duration.value(31, 'd');
      }

      // Live-location presence for travel-time reminders; owner access is self-only
      // here, with admins reading all via the collectionGroup rule below.
      // `updatedAt == request.time` forces serverTimestamp() so a client can't fake
      // freshness with a future timestamp.
      match /presence/{presenceId} {
        allow read, delete: if isActiveUser() && myDocId() == userId;
        allow create, update: if isActiveUser()
          && myDocId() == userId
          && presenceId == 'location'
          && request.resource.data.keys().hasOnly(
              ['lat', 'lng', 'updatedAt', 'uid'])
          && request.resource.data.lat is number
          && request.resource.data.lat >= -90
          && request.resource.data.lat <= 90
          && request.resource.data.lng is number
          && request.resource.data.lng >= -180
          && request.resource.data.lng <= 180
          && request.resource.data.updatedAt == request.time
          && request.resource.data.uid == request.auth.uid;
      }
    }

    // ── presence (admin live-map read) ───────────────────────────────────
    // Grants admins read (get + list, including collectionGroup) over every presence
    // subcollection; the nested rule above still governs owner access. isAdmin() is
    // caller-side only, keeping the unfiltered collection-group query provable.
    // Note: {path=**} reserves the `presence` subcollection name for any future
    // collection too.
    match /{path=**}/presence/{presenceId} {
      allow read: if isAdmin();
    }

    // ── appointments ──────────────────────────────────────────────────────────
    // Lifecycle is pending -> in_progress -> done, plus cancelled; employee writes are
    // further restricted to 'done' only (see below).
    function isValidAppointmentStatus(s) {
      return s in ['pending', 'in_progress', 'done', 'cancelled'];
    }

    match /appointments/{appointmentId} {
      // Read: admin sees all; assigned employee sees their appointments.
      allow read: if isAdmin() || isAssignedEmployee(resource.data);

      // Admin only; rejects unknown status values from the client.
      allow create: if isAdmin()
        && isValidAppointmentStatus(request.resource.data.status);

      // Admin has full access (status allowlist enforced); an assigned employee may
      // only flip status to 'done', nothing else.
      allow update: if (isAdmin()
            && isValidAppointmentStatus(request.resource.data.status))
        || (isAssignedEmployee(resource.data)
            && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['status', 'updatedAt'])
            && request.resource.data.status == 'done');

      // Delete: admin only.
      allow delete: if isAdmin();
    }

    // ── clients ───────────────────────────────────────────────────────────────
    // Client PII, admin-only — employees never need direct access.
    function isValidClientData(data) {
      return (!('name' in data) || (data.name is string && data.name.size() <= 200))
        && (!('businessName' in data) || (data.businessName is string && data.businessName.size() <= 200))
        && (!('firstName' in data) || (data.firstName is string && data.firstName.size() <= 200))
        && (!('lastName' in data) || (data.lastName is string && data.lastName.size() <= 200))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 32))
        && (!('mobile' in data) || (data.mobile is string && data.mobile.size() <= 32))
        && (!('email' in data) || (data.email is string && data.email.size() <= 320))
        && (!('address' in data) || (data.address is string && data.address.size() <= 500))
        && (!('apt' in data) || (data.apt is string && data.apt.size() <= 64))
        && (!('city' in data) || (data.city is string && data.city.size() <= 128))
        && (!('province' in data) || (data.province is string && data.province.size() <= 128))
        && (!('country' in data) || (data.country is string && data.country.size() <= 128))
        && (!('postalCode' in data) || (data.postalCode is string && data.postalCode.size() <= 32))
        // KNOWN GAP: rules can't cap contact element strings (only array length), so an
        // admin write can still reach Firestore's 1 MB ceiling and fan out via
        // propagateClientEdits — accepted since it's admin-only. Fix properly with a
        // per-field TextLimits cap in the contacts editor, not by tightening this number.
        && (!('contacts' in data) || (data.contacts is list && data.contacts.size() <= 50))
        && (!('noFixedAddress' in data) || data.noFixedAddress is bool);
    }

    match /clients/{clientId} {
      allow read: if isAdmin();
      // `waveCustomerId` and `wave` are written exclusively by Cloud Functions
      // via Admin SDK (which bypasses these rules). The client app must never
      // set or modify these fields; reject any create that includes them.
      allow create: if isAdmin()
        && isValidClientData(request.resource.data)
        && !('waveCustomerId' in request.resource.data.keys())
        && !('wave' in request.resource.data.keys());
      // For updates, reject only if the client is changing/adding the Wave
      // fields — an update that leaves them untouched has no affected keys.
      allow update: if isAdmin()
        && isValidClientData(request.resource.data)
        && !request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasAny(['waveCustomerId', 'wave']);
      allow delete: if isAdmin();
    }

    // ── wave (Wave Accounting connection metadata) ────────────────────────────
    // Written exclusively by Cloud Functions via Admin SDK (connection status,
    // businessId, last-sync timestamps; the access token lives only in Secret
    // Manager, never here). No client may read connection state — treat this
    // collection like rateLimits. The default
    // deny-everything would already block access; the explicit rule documents
    // intent for a security-sensitive collection.
    match /wave/{docId} {
      allow read, write: if false;
    }

    // ── waveSyncQueue (outbox for Wave API sync jobs) ─────────────────────────
    // Jobs are enqueued and processed exclusively by Cloud Functions via Admin
    // SDK. No client may read pending jobs, inspect retry state, or reset the
    // queue — doing so could expose Wave API credentials embedded in job
    // payloads or allow a client to cancel/replay sync operations.
    match /waveSyncQueue/{jobId} {
      allow read, write: if false;
    }
  }
}
