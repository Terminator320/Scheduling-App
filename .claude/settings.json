{
  "permissions": {
    "allow": [
      "Bash(flutter analyze)",
      "Bash(flutter analyze *)",
      "Bash(flutter test)",
      "Bash(flutter test *)",
      "Bash(flutter pub get)",
      "Bash(flutter pub outdated)",
      "Bash(flutter pub deps)",
      "Bash(flutter devices)",
      "Bash(flutter doctor)",
      "Bash(flutter --version)",
      "Bash(dart analyze *)",
      "Bash(dart format --output=none *)",
      "Bash(dart pub deps)",
      "Bash(flutter build apk)",
      "Bash(flutter build apk *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-save.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/gen-l10n.sh\"",
            "timeout": 180,
            "statusMessage": "flutter gen-l10n (ARB changed)"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous-commands.sh\""
          }
        ]
      }
    ]
  }
}
