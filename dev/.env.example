# Template for dev/.env — the runtime Firebase client configuration.
#
# Setup: copy this file to dev/.env and fill in the real values. dev/.env is
# gitignored (see `*.env` in .gitignore) and bundled as a Flutter asset at
# build time (see `assets:` in pubspec.yaml). lib/firebase_options.dart reads
# the Firebase keys below via flutter_dotenv and throws at startup if one is
# missing; IOS_MAPS_API_KEY is read separately by AppDelegate.swift (see below).
#
# Where the values come from:
#   Firebase console -> Project settings -> General -> Your apps, or run
#   `flutterfire configure` and copy the values it prints for each platform.

# Android app (Firebase console -> Your apps -> Android app).
# The app is iOS-only (android/ was deleted 2026-08-05), but these two are
# STILL REQUIRED: firebase_options.dart throws at startup for any missing key,
# and they back DefaultFirebaseOptions.android, which is retained because the
# Android Firebase app still exists in the console.
FIREBASE_API_KEY=your-android-api-key
APP_ID=1:000000000000:android:0000000000000000000000

# Shared project values (platform-neutral)
MESSAGING_SENDER_ID=000000000000
PROJECT_ID=your-project-id
STORAGE_BUCKET=your-project-id.firebasestorage.app

# iOS app (Firebase console -> Your apps -> iOS app, bundle net.vogas.scheduling)
IOS_API_KEY=your-ios-api-key
IOS_APP_ID=1:000000000000:ios:0000000000000000000000

# iOS Google Maps client key (RESTRICTED to the bundle id + Maps SDK). Read
# natively by ios/Runner/AppDelegate.swift, NOT firebase_options.dart. A blank
# value renders the admin live staff map blank. Distinct from the server-side
# GOOGLE_MAP_API_KEY (Secret Manager only — never ships in the app).
IOS_MAPS_API_KEY=your-ios-maps-client-key
